generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  STARTER
  GROWTH
  EMPIRE
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
  VIEWER
}

enum Status {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum Freq {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Tenant {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  taxId       String?     @map("tax_id")
  plan        Plan        @default(STARTER)
  settings    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  users       User[]
  projects    Project[]
  fixedCosts  FixedCost[]
  @@map("tenants")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  email         String
  passwordHash  String      @map("password_hash")
  fullName      String      @map("full_name")
  role          Role        @default(EMPLOYEE)
  hourlyCost    Decimal?    @map("hourly_cost") @db.Decimal(10,2)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]
  @@unique([tenantId, email])
  @@map("users")
}

model Project {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  clientName    String?     @map("client_name")
  clientTaxId   String?     @map("client_tax_id")
  name          String
  description   String?
  status        Status      @default(DRAFT)
  budgetHours   Decimal?    @map("budget_hours") @db.Decimal(10,2)
  budgetAmount  Decimal?    @map("budget_amount") @db.Decimal(12,2)
  startDate     DateTime?   @map("start_date") @db.Date
  endDate       DateTime?   @map("end_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]
  varCosts      VariableCost[]
  @@map("projects")
}

model TimeEntry {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  projectId     String      @map("project_id") @db.Uuid
  description   String?
  startedAt     DateTime    @map("started_at")
  endedAt       DateTime?   @map("ended_at")
  durationMin   Int         @map("duration_min")
  isBillable    Boolean     @default(true) @map("is_billable")
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User        @relation(fields: [userId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])
  @@map("time_entries")
}

model FixedCost {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  amount      Decimal     @db.Decimal(12,2)
  frequency   Freq        @default(MONTHLY)
  category    String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("fixed_costs")
}

model VariableCost {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  projectId   String?     @map("project_id") @db.Uuid
  name        String
  amount      Decimal     @db.Decimal(12,2)
  date        DateTime    @db.Date
  category    String?
  createdAt   DateTime    @default(now()) @map("created_at")
  project     Project?    @relation(fields: [projectId], references: [id])
  @@map("variable_costs")
}

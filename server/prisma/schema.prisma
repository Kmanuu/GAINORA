generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String      @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String      @unique
  taxId                 String?     @map("tax_id")
  plan                  TenantPlan  @default(STARTER)
  settings              Json        @default("{}")
  plannedCapacityHours  Int         @default(160) @map("planned_capacity_hours")
  targetMarginPct       Decimal     @default(30) @map("target_margin_pct") @db.Decimal(5, 2)
  costingMode           CostingMode @default(ABSORPTION) @map("costing_mode")
  reliabilityMinHours   Int         @default(5) @map("reliability_min_hours")
  /// Criterio fiscal:
  ///   ACCRUAL (devengo, valor por defecto en autónomos en factura) →
  ///     contabiliza ingresos/gastos por fecha de emisión.
  ///   CASH (caja) → cuenta sólo cuando el dinero entra/sale realmente.
  ///   Aplica al cálculo de los modelos 303 y 130 (resumen fiscal).
  taxCriterion          TaxCriterion @default(ACCRUAL) @map("tax_criterion")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  clients               Client[]
  contracts             Contract[]
  fixedCosts            FixedCost[]
  invoices              Invoice[]
  invoiceSeries         InvoiceSeries[]
  issues                Issue[]
  payments              Payment[]
  paymentTransactions   PaymentTransaction[]
  plans                 Plan[]
  projects              Project[]
  users                 User[]

  @@map("tenants")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  email        String
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  role         Role        @default(EMPLOYEE)
  hourlyCost   Decimal?    @map("hourly_cost") @db.Decimal(10, 2)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  timeEntries  TimeEntry[]
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model Project {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  clientId               String         @map("client_id") @db.Uuid
  name                   String
  description            String?
  status                 Status         @default(DRAFT)
  billingMode            BillingMode    @default(FIXED) @map("billing_mode")
  budgetHours            Decimal?       @map("budget_hours") @db.Decimal(10, 2)
  budgetAmount           Decimal?       @map("budget_amount") @db.Decimal(12, 2)
  hourlyRate             Decimal?       @map("hourly_rate") @db.Decimal(10, 2)
  partsMarkupPct         Decimal?       @map("parts_markup_pct") @db.Decimal(5, 2)
  productMaintenanceCost Decimal?       @map("product_maintenance_cost") @db.Decimal(12, 2)
  startDate              DateTime?      @map("start_date") @db.Date
  endDate                DateTime?      @map("end_date") @db.Date
  isDemo                 Boolean        @default(false) @map("is_demo")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  client                 Client         @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  contracts              Contract[]
  tenant                 Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries            TimeEntry[]
  varCosts               VariableCost[]

  @@index([clientId])
  @@map("projects")
}

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  taxId     String?    @map("tax_id")
  email     String?
  phone     String?
  notes     String?
  /// Régimen fiscal del cliente. Determina IVA aplicable y notas legales en factura:
  ///   NATIONAL  — España (default). IVA estándar.
  ///   EU_INTRA  — UE (no España). IVA 0%, art. 25 LIVA.
  ///   NON_EU    — Tercer país. IVA 0%, exportación de servicios.
  taxRegime TaxRegime  @default(NATIONAL) @map("tax_regime")
  /// Si true, se aplica recargo de equivalencia en sus facturas
  /// (5,2% sobre 21%, 1,4% sobre 10%, 0,5% sobre 4%).
  hasSurcharge Boolean @default(false) @map("has_surcharge")
  isDemo    Boolean    @default(false) @map("is_demo")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts Contract[]
  invoices  Invoice[]  @relation("ClientInvoices")
  projects  Project[]  @relation("ClientProjects")

  @@index([tenantId])
  @@map("clients")
}

model Plan {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  name                String
  tier                ContractTier    @default(FREE)
  description         String?
  billingMode         BillingMode     @default(SUBSCRIPTION) @map("billing_mode")
  price               Decimal         @default(0) @db.Decimal(12, 2)
  setupFee            Decimal?        @map("setup_fee") @db.Decimal(12, 2)
  hourlyRate          Decimal?        @map("hourly_rate") @db.Decimal(10, 2)
  partsMarkupPct      Decimal?        @map("parts_markup_pct") @db.Decimal(5, 2)
  maintenanceMode     MaintenanceMode @default(NONE) @map("maintenance_mode")
  maintenanceExtraPct Decimal?        @map("maintenance_extra_pct") @db.Decimal(5, 2)
  vatRate             Decimal         @default(21) @map("vat_rate") @db.Decimal(5, 2)
  priceIncludesVat    Boolean         @default(false) @map("price_includes_vat")
  features            Json            @default("[]")
  limits              Json            @default("{}")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  contracts           Contract[]
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("plans")
}

model Contract {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  projectId              String          @map("project_id") @db.Uuid
  clientId               String          @map("client_id") @db.Uuid
  tier                   ContractTier    @default(FREE)
  billingMode            BillingMode     @default(FIXED) @map("billing_mode")
  price                  Decimal         @default(0) @db.Decimal(12, 2)
  setupFee               Decimal?        @map("setup_fee") @db.Decimal(12, 2)
  hourlyRate             Decimal?        @map("hourly_rate") @db.Decimal(10, 2)
  budgetHours            Decimal?        @map("budget_hours") @db.Decimal(10, 2)
  partsMarkupPct         Decimal?        @map("parts_markup_pct") @db.Decimal(5, 2)
  maintenanceMode        MaintenanceMode @default(NONE) @map("maintenance_mode")
  maintenanceExtraPct    Decimal?        @map("maintenance_extra_pct") @db.Decimal(5, 2)
  maintenanceFixedAmount Decimal?        @map("maintenance_fixed_amount") @db.Decimal(12, 2)
  billingDay             Int?            @map("billing_day")
  billingFrequency       Freq            @default(MONTHLY) @map("billing_frequency")
  /// Retención IRPF por defecto al generar pagos/facturas. null = no aplica.
  /// España: 15% para profesionales, 7% nuevos autónomos primer año.
  irpfRate               Decimal?        @map("irpf_rate") @db.Decimal(5, 2)
  priceIncludesVat       Boolean         @default(false) @map("price_includes_vat")
  vatRate                Decimal         @default(21) @map("vat_rate") @db.Decimal(5, 2)
  status                 ContractStatus  @default(ACTIVE)
  startedAt              DateTime        @map("started_at") @db.Date
  endedAt                DateTime?       @map("ended_at") @db.Date
  notes                  String?
  isDemo                 Boolean         @default(false) @map("is_demo")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  planId                 String?         @map("plan_id") @db.Uuid
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan                   Plan?           @relation(fields: [planId], references: [id])
  project                Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices               Invoice[]
  issues                 Issue[]
  payments               Payment[]
  timeEntries            TimeEntry[]
  varCosts               VariableCost[]

  @@index([tenantId, status])
  @@index([projectId])
  @@index([clientId])
  @@index([planId])
  @@map("contracts")
}

model Issue {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  contractId    String         @map("contract_id") @db.Uuid
  title         String
  description   String?
  isBillable    Boolean        @default(false) @map("is_billable")
  internalFault Boolean        @default(false) @map("internal_fault")
  openedAt      DateTime       @default(now()) @map("opened_at")
  closedAt      DateTime?      @map("closed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]
  varCosts      VariableCost[]

  @@index([tenantId])
  @@index([contractId])
  @@map("issues")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  contractId  String        @map("contract_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?     @map("paid_at")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  amountNet   Decimal       @map("amount_net") @db.Decimal(12, 2)
  vatRate     Decimal       @default(21) @map("vat_rate") @db.Decimal(5, 2)
  amountGross Decimal       @map("amount_gross") @db.Decimal(12, 2)
  amountDue   Decimal       @map("amount_due") @db.Decimal(12, 2)
  /// Retención IRPF aplicada al generar este pago. Si > 0, el cliente
  /// paga (amountGross - irpfAmount); el IRPF lo ingresa al Estado.
  irpfAmount  Decimal       @default(0) @map("irpf_amount") @db.Decimal(12, 2)
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  transactions PaymentTransaction[]

  @@unique([contractId, periodStart])
  @@index([tenantId, status])
  @@map("payments")
}

model PaymentTransaction {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  paymentId String        @map("payment_id") @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @map("paid_at")
  method    PaymentMethod @default(TRANSFER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId],  references: [id], onDelete: Cascade)
  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([tenantId, paidAt])
  @@map("payment_transactions")
}

model InvoiceSeries {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  code       String    // "A" general, "R" rectificativas, "F" simplificadas, etc.
  name       String
  nextNumber Int       @default(1) @map("next_number")
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices   Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("invoice_series")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  seriesId            String        @map("series_id") @db.Uuid
  /// number es null mientras Invoice está DRAFT; se asigna atómicamente al
  /// emitir (issue) consumiendo InvoiceSeries.nextNumber. Una vez emitida,
  /// el número es inmutable.
  number              Int?
  status              InvoiceStatus @default(DRAFT)
  issueDate           DateTime      @map("issue_date") @db.Date
  dueDate             DateTime?     @map("due_date") @db.Date
  contractId          String?       @map("contract_id") @db.Uuid
  clientId            String        @map("client_id") @db.Uuid
  paymentId           String?       @map("payment_id") @db.Uuid
  rectifiesInvoiceId  String?       @map("rectifies_invoice_id") @db.Uuid
  subtotalNet         Decimal       @default(0) @map("subtotal_net") @db.Decimal(12, 2)
  totalVat            Decimal       @default(0) @map("total_vat") @db.Decimal(12, 2)
  totalIrpf           Decimal       @default(0) @map("total_irpf") @db.Decimal(12, 2)
  totalSurcharge      Decimal       @default(0) @map("total_surcharge") @db.Decimal(12, 2)
  totalGross          Decimal       @default(0) @map("total_gross") @db.Decimal(12, 2)
  notes               String?
  /// Cadena VeriFactu (RD 1007/2023). Se calculan en issueInvoice
  /// (status: DRAFT → ISSUED). La cadena encadena por serie:
  /// previousHash = currentHash de la última invoice ISSUED/PAID/VOIDED de la serie.
  previousHash        String?       @map("previous_hash") @db.VarChar(64)
  currentHash         String?       @map("current_hash") @db.VarChar(64)
  /// URL/payload codificado en el QR impreso en el PDF.
  qrPayload           String?       @map("qr_payload")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  tenant              Tenant        @relation(fields: [tenantId],   references: [id], onDelete: Cascade)
  series              InvoiceSeries @relation(fields: [seriesId],   references: [id], onDelete: Restrict)
  client              Client        @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: Restrict)
  contract            Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  payment             Payment?      @relation(fields: [paymentId],  references: [id], onDelete: SetNull)
  rectifies           Invoice?      @relation("InvoiceRectifies", fields: [rectifiesInvoiceId], references: [id], onDelete: SetNull)
  rectifiedBy         Invoice[]     @relation("InvoiceRectifies")
  lines               InvoiceLine[]

  auditLogs           InvoiceAuditLog[]

  @@unique([tenantId, seriesId, number])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([contractId])
  @@index([paymentId])
  @@map("invoices")
}

/// Log inmutable (insert-only) de eventos sobre una factura. Se usa para
/// auditoría VeriFactu: cada emisión y anulación deja un registro con el
/// snapshot de los datos relevantes y el hash. Ningún update/delete debería
/// tocar estas filas en producción (se respeta a nivel de aplicación).
model InvoiceAuditLog {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  invoiceId  String              @map("invoice_id") @db.Uuid
  userId     String?             @map("user_id") @db.Uuid
  action     InvoiceAuditAction
  payload    Json
  hash       String              @db.VarChar(64)
  createdAt  DateTime            @default(now()) @map("created_at")

  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId, createdAt])
  @@map("invoice_audit_logs")
}

model InvoiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  description   String
  quantity      Decimal  @default(1) @db.Decimal(12, 4)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 4)
  vatRate       Decimal  @default(21) @map("vat_rate") @db.Decimal(5, 2)
  irpfRate      Decimal  @default(0) @map("irpf_rate") @db.Decimal(5, 2)
  /// Recargo equivalencia. 5,2% si vatRate=21, 1,4% si 10, 0,5% si 4. 0 default.
  surchargeRate Decimal  @default(0) @map("surcharge_rate") @db.Decimal(5, 2)
  discount      Decimal  @default(0) @db.Decimal(5, 2)
  /// Calculados al guardar (no confiar en el cliente).
  lineNet       Decimal  @map("line_net")   @db.Decimal(12, 2)
  lineSurcharge Decimal  @default(0) @map("line_surcharge") @db.Decimal(12, 2)
  lineGross     Decimal  @map("line_gross") @db.Decimal(12, 2)
  position      Int      @default(0)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model TimeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  contractId  String?   @map("contract_id") @db.Uuid
  issueId     String?   @map("issue_id") @db.Uuid
  description String?
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationMin Int       @map("duration_min")
  isBillable  Boolean   @default(true) @map("is_billable")
  createdAt   DateTime  @default(now()) @map("created_at")
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  issue       Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([issueId])
  @@map("time_entries")
}

model FixedCost {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  amount       Decimal  @db.Decimal(12, 2)
  frequency    Freq     @default(MONTHLY)
  category     String?
  /// Si es bien de inversión (ordenador, mobiliario…), su IVA va a las
  /// casillas 30/31 del modelo 303 en lugar de 28/29. Default: false.
  isInvestment Boolean  @default(false) @map("is_investment")
  isActive     Boolean  @default(true) @map("is_active")
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("fixed_costs")
}

model VariableCost {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  contractId       String?   @map("contract_id") @db.Uuid
  issueId          String?   @map("issue_id") @db.Uuid
  name             String
  amount           Decimal   @db.Decimal(12, 2)
  quantity         Decimal   @default(1) @db.Decimal(10, 2)
  priceIncludesVat Boolean   @default(false) @map("price_includes_vat")
  vatRate          Decimal   @default(21) @map("vat_rate") @db.Decimal(5, 2)
  markupPct        Decimal?  @map("markup_pct") @db.Decimal(5, 2)
  date             DateTime  @db.Date
  category         String?
  /// Si es bien de inversión, su IVA va a casillas 30/31 (no 28/29) del 303.
  isInvestment     Boolean   @default(false) @map("is_investment")
  createdAt        DateTime  @default(now()) @map("created_at")
  contract         Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  issue            Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([issueId])
  @@map("variable_costs")
}

enum TenantPlan {
  STARTER
  GROWTH
  EMPIRE
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  EMPLOYEE
  VIEWER
}

enum Status {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum Freq {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BillingMode {
  FIXED
  HOURLY
  HYBRID
  SUBSCRIPTION
}

enum ContractTier {
  FREE
  PRO
  MAX
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum MaintenanceMode {
  NONE
  SHARED
  CUSTOM
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  TRANSFER
  CARD
  CASH
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum InvoiceAuditAction {
  ISSUE
  VOID
  RECTIFY
}

enum CostingMode {
  ABSORPTION
  CONTRIBUTION
}

enum TaxCriterion {
  ACCRUAL
  CASH
}

enum TaxRegime {
  NATIONAL
  EU_INTRA
  NON_EU
}
